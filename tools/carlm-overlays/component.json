{
  "id": "carlm-overlays",
  "kind": "tool",
  "version": "0.9.0",
  "title": "Overlays",
  "description": "QuickSelect strip (iDrive 8.5 style) in the climate bar: four shortcuts, each with its own icon if picked (tap opens, hold 1 s saves the screen you are on), seat heating / ventilation in the HMI's own spots, steering wheel heating, M1 / M2 switch the M Mode, and a start can too (Road / Sport / Track); each seat / wheel button can be nudged into place (the app's Align page); shift lights on the cluster for cars without their own (not M cars; with Cluster renderer 0.3.6 or newer). Set up in the eOverlays app (carlm_overlays). Own ids, beside IterioDev's iteriodev-overlays: uninstall that one, only one strip can show. Needs Renderer (mgu-render) 0.6.10 or newer.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID8"
  ],
  "requires": {
    "mgu-render": "0.6.10",
    "mgu-deploy": "0.7.11"
  },
